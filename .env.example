# ==============================================================================
# Embedding & Rerank API Environment Configuration
# ==============================================================================

# API Port (default: 8000)
APP_PORT=8000

# API Authentication Key (leave empty to disable authentication)
API_KEY=test_api_key_secret

# Gunicorn Worker Process Count (default: 2)
GUNICORN_WORKERS=2

# Offline Mode (Set to true to disable all Hugging Face network downloads and enforce air-gapped offline operation)
# When set to true, HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1, HF_DATASETS_OFFLINE=1 are automatically enabled.
OFFLINE_MODE=false

# Hugging Face Cache Location
HF_HOME=/home/appuser/.cache/huggingface

# Input Validation Limits
MAX_INPUT_LENGTH=65536
MAX_INPUT_ITEMS=256
