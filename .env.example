# ==============================================================================
# Embedding & Rerank API Environment Configuration
# ==============================================================================

# API Port (default: 8000)
APP_PORT=8000

# API Authentication Key (leave empty to disable authentication)
API_KEY=test_api_key_secret

# Gunicorn Worker Process Count (default: 2)
GUNICORN_WORKERS=2

# Offline Mode (Set to true to disable all Hugging Face network downloads and enforce air-gapped offline operation)
# When set to true, HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1, HF_DATASETS_OFFLINE=1 are automatically enabled.
OFFLINE_MODE=false

# Hugging Face Cache Location
HF_HOME=/home/appuser/.cache/huggingface

# Input Validation Limits
MAX_INPUT_LENGTH=65536
MAX_INPUT_ITEMS=256

# Concurrency & SRE Protection
# MAX_CONCURRENT_INFERENCES: Maximum concurrent inference requests handled in parallel via async semaphore.
MAX_CONCURRENT_INFERENCES=4
INFERENCE_SEMAPHORE_TIMEOUT_SECONDS=30.0

# Multi-Tenant Auth & Rate Limiting
# API_KEYS="key1,key2" or JSON format '{"key1": 60, "key2": 120}'
# API_KEYS=
RATE_LIMIT_PER_MINUTE=120

# Logit Gate & Hybrid Reranker Settings
LOGIT_GATE_ENABLED=true
LOGIT_GATE_DEFAULT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOGIT_GATE_THRESHOLD=0.55
LOGIT_GATE_ASCII_BOOST_WEIGHT=1.2
LOGIT_GATE_BATCH_SIZE=8
LOGIT_GATE_MAX_DOC_CHARS=1500
LOGIT_GATE_BASELINE_MARGIN=0.0

# PyTorch Inference Precision ("" for float32 default, "bfloat16", or "float16")
# bfloat16 is recommended for Ampere/Ada/Hopper architectures (RTX 3000+, A100, etc.)
TORCH_DTYPE=

# Preload Models on Startup (comma-separated list of model names to eliminate cold-start latency)
# PRELOAD_MODELS=cl-nagoya/ruri-v3-310m,google/embeddinggemma-2,cl-nagoya/ruri-v3-reranker-310m
PRELOAD_MODELS=

# Optional Multimodal Extensions (google/embeddinggemma-2)
ENABLE_AUDIO_EMBEDDING=false
ENABLE_VIDEO_EMBEDDING=false
MAX_AUDIO_DURATION_SEC=30
MAX_VIDEO_FRAMES=16

# ==============================================================================
# Hardware / VRAM Capacity Tuning Profiles (Examples)
# ==============================================================================
#
# Profile A: Standard 12GB VRAM (e.g., RTX 3060, 4060 Ti 16GB)
# - Peak VRAM: ~10.1 GB (when 4 models are loaded)
# - Balanced concurrency and memory safety:
#   MAX_CONCURRENT_INFERENCES=8
#   INFERENCE_SEMAPHORE_TIMEOUT_SECONDS=60.0
#   MAX_INPUT_ITEMS=256
#   LOGIT_GATE_BATCH_SIZE=8
#   LOGIT_GATE_DEFAULT_MODEL=Takenoko12345678/Qwen3.5-0.8B-Japanese-SFT-v2
#   TORCH_DTYPE=bfloat16
#   PRELOAD_MODELS=cl-nagoya/ruri-v3-310m,google/embeddinggemma-2,cl-nagoya/ruri-v3-reranker-310m
#
# Profile B: High-VRAM 24GB (e.g., RTX 3090, RTX 4090, A10G)
# - High throughput, full model residency, and larger batch size:
#   MAX_CONCURRENT_INFERENCES=16
#   INFERENCE_SEMAPHORE_TIMEOUT_SECONDS=60.0
#   MAX_INPUT_ITEMS=512
#   LOGIT_GATE_BATCH_SIZE=32
#   LOGIT_GATE_DEFAULT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#   TORCH_DTYPE=bfloat16
#   PRELOAD_MODELS=cl-nagoya/ruri-v3-310m,google/embeddinggemma-2,cl-nagoya/ruri-v3-reranker-310m,bge-visualized-m3,Qwen/Qwen2.5-1.5B-Instruct
#
# Profile C: Data Center 40GB / 80GB (e.g., A100, L40S, H100)
# - Massive parallel concurrency and high batch throughput:
#   MAX_CONCURRENT_INFERENCES=32
#   INFERENCE_SEMAPHORE_TIMEOUT_SECONDS=120.0
#   MAX_INPUT_ITEMS=1024
#   LOGIT_GATE_BATCH_SIZE=64
#   LOGIT_GATE_DEFAULT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#   TORCH_DTYPE=bfloat16
#   PRELOAD_MODELS=cl-nagoya/ruri-v3-310m,google/embeddinggemma-2,cl-nagoya/ruri-v3-reranker-310m,bge-visualized-m3,Qwen/Qwen2.5-1.5B-Instruct

